# Copy to .env.local for local work. On Vercel set these in Settings → Environment Variables.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Sanity → API → Tokens → Add API token (Editor). Secret: never commit it.
SANITY_WRITE_TOKEN=
# Any long random string; used once to import the 12 demo machines: /api/seed?secret=...
SEED_SECRET=
# Optional: public site address for sitemap/SEO
NEXT_PUBLIC_SITE_URL=https://kosmakine.com
